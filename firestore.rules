rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in ['raosumityadav420@gmail.com', 'raosahil8290@gmail.com']
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && currentUser().data.role == 'admin')
      );
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && (request.resource.data.role == 'customer' || request.auth.token.email in ['raosumityadav420@gmail.com', 'admin@yashtent.com', 'raosahil8290@gmail.com'])
        && request.resource.data.email == request.auth.token.email;

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['name', 'phone', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.status == 'Pending'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0;

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['Pending', 'Confirmed', 'Cancelled'];

      allow delete: if false;
    }

    match /galleryItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
